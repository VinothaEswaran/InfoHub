# --- App ---
APP_NAME=InfoHub
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./infohub.db
# Production (Docker Compose provides this automatically):
# DATABASE_URL=postgresql+asyncpg://infohub:infohub@postgres:5432/infohub

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Breach Monitoring ---
HIBP_API_KEY=your-haveibeenpwned-api-key

# --- AI Summarization ---
# Either set an OpenAI-compatible key, or leave blank to use the local
# HuggingFace transformers pipeline (services/policy_summarizer.py)
OPENAI_API_KEY=
SUMMARIZATION_MODEL=facebook/bart-large-cnn
